# Copy to .env (or set these in your host's dashboard)
PORT=3000
APP_URL=https://schedules.collegestationlittleleague.com
TZ=America/Chicago

# First admin account (created on first start if no admin exists)
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_FIRST=Kevin
ADMIN_LAST=Henderson

# Text messages (Twilio). Leave blank to log messages to the console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=            # +1979xxxxxxx or a Messaging Service SID (MG...)

# Email (any SMTP: Google Workspace, SendGrid, Postmark...). Leave blank to log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CSLL Schedules <schedules@collegestationlittleleague.com>

# Database file location (put it on a persistent disk)
DB_PATH=./data/csll.db

# NEVER true in real use: shows login codes on screen for testing
DEMO_MODE=false
